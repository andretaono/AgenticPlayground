<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

		<!-- Make new files default to Game.* namespace -->
		<RootNamespace>Game</RootNamespace>
		<!-- Optional: set assembly name to match -->
		<AssemblyName>Game</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TestRunner/**" />
    <Compile Remove="AgenticPlayGround.Tests/**" />
    <Compile Remove="AgenticPlayGround.Unity/**" />
    <Compile Remove="Tests/**" />
    <Compile Remove="Systems/**/Tests/**" />
    <Compile Remove="Systems/Foundation/Testing/**" />
  </ItemGroup>

  <Target Name="CopyGameDllToUnity" AfterTargets="Build" Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\AgenticPlayGround.Unity\Assets\Plugins\Game\" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Copied Game.dll to Unity plugin folder." />
  </Target>

</Project>
